# Copy to .env next to docker-compose.yml and fill in. Never commit the filled copy.
# Credentials are not set here. They are files under ./secrets/, created on the host that
# runs the container and owned by the same account that owns ./data.

# Full image reference including the tag. Every published tag moves: ':latest' follows the
# main branch, ':test' follows develop, and a version tag is rewritten whenever that same
# version is built again.
IMAGE=

# Used when TLS_MODE=acme: the public hostname certificates are issued for, and the
# contact address given to the certificate authority.
DOMAIN=
ACME_EMAIL=

# 'off' serves plain HTTP on HTTP_PORT, for a machine where a reverse proxy in front
# terminates TLS and forwards to this container. 'acme' makes the container obtain and
# renew certificates for DOMAIN itself — for that, also uncomment the HTTPS line in
# docker-compose.yml and use BIND_ADDR=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443 below
# (certificate issuance needs port 80 reachable from the internet).
TLS_MODE=off

# Where the container is published on this host. The loopback address keeps it reachable
# from this machine only — point the reverse proxy at http://127.0.0.1:<HTTP_PORT>.
# HTTPS_PORT is read only by the commented HTTPS line in docker-compose.yml.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Login name of the administrator account. Its password is ./secrets/admin_password.
ADMIN_USERNAME=admin

# How often an open document is written to disk, in seconds.
AUTOSAVE_SECONDS=10

# Session lifetimes in seconds.
ACCESS_TTL=600
REFRESH_TTL=2592000

# Version history retention, per page.
VERSIONS_KEEP=50
VERSIONS_DAYS=30

# How long a deleted document stays restorable, in days.
TRASH_DAYS=30

# Database backup cadence and retention.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Largest single upload accepted, in megabytes. Also the ceiling every document
# snapshot must fit through.
UPLOAD_MAX_MB=25

# Self-registration. Registered accounts see nothing until whitelisted in the admin
# screen; the pending cap bounds how many unapproved accounts can exist at once.
REGISTRATION_ENABLED=true
REGISTRATION_PENDING_MAX=20

# Ceilings for code projects. CODE_MAX_PROJECT_MB must not exceed UPLOAD_MAX_MB —
# the container refuses to start otherwise.
CODE_MAX_FILES=200
CODE_MAX_FILE_KB=512
CODE_MAX_PROJECT_MB=20

# Owner of ./data on this host. `id -u` and `id -g` for the account that owns it.
PUID=1000
PGID=1000

TZ=UTC
