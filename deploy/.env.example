# Copy to .env next to docker-compose.yml and fill in. Never commit the filled copy.
# Credentials are not set here. They are files under ./secrets/, created on the host that
# runs the container and owned by the same account that owns ./data.

# Full image reference including the tag. Every published tag moves: ':latest' follows the
# main branch, ':test' follows develop, and a version tag is rewritten whenever that same
# version is built again.
IMAGE=

# Public hostname and the contact address used when obtaining certificates.
DOMAIN=
ACME_EMAIL=

# 'acme' obtains and renews certificates for DOMAIN. 'off' serves plain HTTP on the
# PUBLISH_HTTP port, for a machine that already terminates TLS in front of this one.
TLS_MODE=acme

# Each entry is a complete Docker port publication: host address, host port, container port.
# Leave both alone for a normal deployment; ACME needs 80 reachable from the internet.
# Behind a reverse proxy on the same machine, bind to loopback instead so only the proxy
# can reach the service, e.g. PUBLISH_HTTP=127.0.0.1:8080:8080 — and keep PUBLISH_HTTPS
# pointing at loopback too, since it cannot be empty: PUBLISH_HTTPS=127.0.0.1:8443:8443.
PUBLISH_HTTP=0.0.0.0:80:8080
PUBLISH_HTTPS=0.0.0.0:443:8443

# Login name of the administrator account. Its password is ./secrets/admin_password.
ADMIN_USERNAME=admin

# How often an open document is written to disk, in seconds.
AUTOSAVE_SECONDS=10

# Session lifetimes in seconds.
ACCESS_TTL=600
REFRESH_TTL=2592000

# Version history retention, per page.
VERSIONS_KEEP=50
VERSIONS_DAYS=30

# How long a deleted document stays restorable, in days.
TRASH_DAYS=30

# Database backup cadence and retention.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Largest single upload accepted, in megabytes.
UPLOAD_MAX_MB=25

# Owner of ./data on this host. `id -u` and `id -g` for the account that owns it.
PUID=1000
PGID=1000

TZ=UTC
