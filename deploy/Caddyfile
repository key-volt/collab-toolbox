{
	admin off
	email {$ACME_EMAIL:noreply@localhost}

	# The host publishes 80 and 443 onto these, so nothing inside needs a privileged port.
	http_port 8080
	https_port 8443

	servers {
		# A reverse proxy in front of this container arrives from a private address. Trusting
		# those ranges makes logs and client-address checks see the forwarded client instead
		# of the docker bridge. Safe only while the published ports are not world-reachable
		# in proxied mode — the loopback BIND_ADDR in .env is what guarantees that.
		trusted_proxies static private_ranges
	}

	# Certificates live on the mounted volume; otherwise every container replacement
	# re-issues them and burns the issuance quota.
	storage file_system {
		root /data/caddy/data
	}
}

{$SITE_ADDRESS} {
	log {
		output stdout
		format console
	}

	# Written by the entrypoint at container start; empty except in custom
	# certificate mode, where it points Caddy at the mounted certificate pair.
	import /run/caddy-tls.conf

	encode zstd gzip

	@https expression `{http.request.scheme} == "https"`
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	header {
		# frame-ancestors is the control that stops another site embedding the editor and
		# reading its bridge traffic as the parent window. frame-src is the mirror of it.
		# Set only if the application did not already send its own policy.
		?Content-Security-Policy "frame-ancestors 'self'; frame-src 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /ws/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle_path /drawio/* {
		root * /app/vendor/drawio
		# No hash-named files in this tree, and an image upgrade can replace any of
		# them under the same name — always revalidate (304 when unchanged).
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /sandbox/* {
		root * /app/sandbox
		# The sandbox page runs in an iframe at an opaque origin, so its every asset
		# fetch is cross-origin. These are public static files; the API sends no such
		# header, which is exactly what keeps sandboxed code away from it.
		header Access-Control-Allow-Origin "*"
		# A deploy replaces the page, the engine and the vendored interpreter under
		# unchanging names, so every use must revalidate — an unchanged file answers
		# 304 and costs no bytes. Only the hash-named build assets never change and
		# are safe to cache hard.
		@hashedSandbox path /assets/*
		header @hashedSandbox Cache-Control "public, max-age=31536000, immutable"
		@mutableSandbox not path /assets/*
		header @mutableSandbox Cache-Control "no-cache"
		# The page's own policy: code from here only, WebAssembly and eval allowed
		# (executing the visitor's code is the feature), all other network dead.
		@page path / /index.html
		header @page Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src blob:; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'"
		file_server
	}

	handle {
		root * /app/web
		# The pages themselves must revalidate (a deploy replaces them in place);
		# the hash-named assets they reference never change and cache hard.
		@hashedWeb path /assets/*
		header @hashedWeb Cache-Control "public, max-age=31536000, immutable"
		@mutableWeb not path /assets/*
		header @mutableWeb Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
